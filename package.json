{
  "name": "desktop-pet",
  "productName": "DesktopPet",
  "version": "0.2.0",
  "description": "桌面宠物 - 可接入云端 API 或本地 Ollama 千问2.5 的桌宠",
  "main": "main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/gen-icon.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.zcode.desktop-pet",
    "productName": "DesktopPet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "DesktopPet-${version}.exe"
    },
    "asar": true
  }
}
